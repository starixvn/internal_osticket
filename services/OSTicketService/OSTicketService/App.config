<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging"/>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
  </configSections>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.18.200.201\private$\entlib" filePath ="log.log" defaultCategory="OsTicket"/>
  <appSettings>
    <add key="RecordsPerAction" value="300"/>
    <add key="TimerInterval" value="1"/>
    <add key="RefreshInterval" value="100"/>
    <add key="OSTicketConnectionString" value="server=10.18.200.204;database=osticket;uid=osticket;password=nYs4tH5cM9yLtJTU;"/>
    <add key="IBCDBService" value="http://qa2.ibc88.com/api/all?leagueid={0}&amp;matchid={1}&amp;teamid={2}&amp;total={3}"/>
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>
  <log4net debug="true">
    <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="Log.txt" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%-5p %d %5rms %-22.22c{1} %-18.18M - %m%n" />
      </layout>
    </appender>

    <root>
      <level value="DEBUG" />
      <appender-ref ref="RollingLogFileAppender" />
    </root>
  </log4net>
</configuration>
